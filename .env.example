# PostgreSQL Configuration
POSTGRES_DB=tasktracker
POSTGRES_USER=tasktracker_app
POSTGRES_PASSWORD=replace_with_strong_password_in_dotenv
POSTGRES_PORT=5432

# Valkey (Redis-compatible) L2 Cache Configuration
VALKEY_PASSWORD=replace_with_strong_valkey_password_in_dotenv
VALKEY_PORT=6379

# ASP.NET Core & Environment
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080

# Authentication & External Identity Provider (OIDC / OAuth2 Resource Server)
# If using external IdP, leave DevIssuer disabled.
# AUTHENTICATION_AUTHORITY=https://auth.example.com
# AUTHENTICATION_AUDIENCE=tasktracker-api

# Development Token Issuer (Enabled ONLY for local development / testing; strictly forbidden in Production)
DEVISSUER_ENABLED=true
DEVISSUER_SIGNINGKEYPATH=./dev-keys/dev-token-es256.key
DEVISSUER_ISSUER=tasktracker-dev-issuer
DEVISSUER_AUDIENCE=tasktracker-api

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18889
