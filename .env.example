# Database configuration (PostgreSQL)
POSTGRES_DB=tasktracker
POSTGRES_USER=tasktracker
POSTGRES_PASSWORD=tasktracker_secret_password
POSTGRES_PORT=5432

# Valkey / Redis configuration
VALKEY_PORT=6379

# Application runtime configuration
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Database=Host=localhost;Port=5432;Database=tasktracker;Username=tasktracker;Password=tasktracker_secret_password
ConnectionStrings__Valkey=localhost:6379

# Security and JWT Issuer configuration
DevIssuer__Enabled=true
DevIssuer__Issuer=tasktracker-dev-issuer
Authentication__Audience=tasktracker-api

# OpenTelemetry collector endpoint (Aspire dashboard)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:18889
