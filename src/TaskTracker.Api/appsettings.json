{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=tasktracker;Username=tasktracker_app;Password=tasktracker_dev_secret",
    "Valkey": "localhost:6379,password=tasktracker_valkey_dev_secret,abortConnect=false"
  },
  "Authentication": {
    "Audience": "tasktracker-api"
  },
  "DevIssuer": {
    "Enabled": true,
    "Issuer": "tasktracker-dev-issuer",
    "Audience": "tasktracker-api",
    "SigningKeyPath": "./dev-keys/dev-token-es256.key"
  },
  "HealthChecks": {
    "Expose": true
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
